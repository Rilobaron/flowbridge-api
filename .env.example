# ==========================================
# Configurações do Servidor
# ==========================================
NODE_ENV=development
PORT=3000
BODY_SIZE_LIMIT=2mb
CORS_ORIGIN=*
RATE_LIMIT_MAX=1000

# ==========================================
# Banco de Dados MongoDB
# ==========================================
MONGODB_URI=mongodb://localhost:27017/flowbridge

# ==========================================
# Redis & BullMQ (Opcional - se vazio usa in-memory fallback)
# ==========================================
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# ==========================================
# Segurança & Autenticação
# ==========================================
# Chave de API para gerenciar rotas administrativas (/api/v1/integrations, /api/v1/events, etc)
ADMIN_API_KEY=sua_chave_admin_secreta_aqui

# Chave mestra de 32 bytes para criptografia AES-256-GCM dos secrets de integração
ENCRYPTION_KEY=sua_chave_de_criptografia_secreta_aqui

# Permitir URLs locais de webhook (localhost/127.0.0.1) em ambiente de desenvolvimento
ALLOW_LOCAL_DESTINATIONS=true

# ==========================================
# Observabilidade e Logs
# ==========================================
LOG_LEVEL=info

# ==========================================
# Retenção de Dados (Dias para expiração TTL no MongoDB - deixe vazio para ilimitado)
# ==========================================
EVENT_RETENTION_DAYS=30
LOG_RETENTION_DAYS=15

# ==========================================
# Configurações Legadas / Mock
# ==========================================
EXTERNAL_API_URL=http://localhost:3000/mock/external-api
TEST_WEBHOOK_URL=http://localhost:3000/webhook
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000
